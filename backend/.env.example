# Copy to .env and fill in your real key. Never commit .env itself.

# https://openrouter.ai - sign up, then check openrouter.ai/models for
# current free-tier model availability before pinning a specific model.
OPENROUTER_API_KEY=your-openrouter-api-key

# "openrouter/auto" lets OpenRouter pick a model automatically.
# For a tool-calling agent, pin a model known to support function
# calling well if "auto" behaves inconsistently (check openrouter.ai/models
# and filter by tool/function-calling support).
OPENROUTER_MODEL=openrouter/auto

MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=INFO
