# --- LLM (required for the assistant) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# --- Production services (leave empty to run fully local) ---
# Start them with:  docker compose up -d   (from the project root)
DATABASE_URL=postgresql://adintel:adintel@localhost:5432/adintel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adintel-graph
# Neo4j Aura: set to the database name Aura shows (often the instance id)
NEO4J_DATABASE=
REDIS_URL=redis://localhost:6379/0
# Production only (AWS S3 / Cloudflare R2). Empty = snapshots on local disk.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=adintel-snapshots
S3_REGION=us-east-1

# --- Sign-in (Clerk). Off by default so the public demo needs no account ---
# Dashboard: https://dashboard.clerk.com -> API keys. Use the SAME publishable
# key as frontend/.env (VITE_CLERK_PUBLISHABLE_KEY).
AUTH_ENABLED=true
VITE_CLERK_PUBLISHABLE_KEY=pk_test_b3B0aW11bS1nb2xkZmlzaC04MDA2LmNsZXJrLmFjY291bnRzLmRldiQ

# --- Usage limits -------------------------------------------------------
# Per user per hour/day. Accounts in RATE_LIMIT_EXEMPT are never limited:
# comma-separated Clerk user ids (Clerk dashboard > Users > user_...) or emails.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_EXEMPT=

# --- Snapshot integrity -------------------------------------------------
# Long random string. Snapshots failing the HMAC check are never unpickled.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SNAPSHOT_SIGNING_KEY=

# Postgres connection pool size (keep under the provider's connection cap).
DB_POOL_MAX=5
