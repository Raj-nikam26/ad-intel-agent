# --- LLM (required for the assistant) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# --- Production services (leave empty to run fully local) ---
# Start them with:  docker compose up -d   (from the project root)
DATABASE_URL=postgresql://adintel:adintel@localhost:5432/adintel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adintel-graph
REDIS_URL=redis://localhost:6379/0
# Production only (AWS S3 / Cloudflare R2). Empty = snapshots on local disk.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=adintel-snapshots

# --- Sign-in (Clerk). Off by default so the public demo needs no account ---
# Dashboard: https://dashboard.clerk.com -> API keys. Use the SAME publishable
# key as frontend/.env (VITE_CLERK_PUBLISHABLE_KEY).
AUTH_ENABLED=true
VITE_CLERK_PUBLISHABLE_KEY=pk_test_b3B0aW11bS1nb2xkZmlzaC04MDA2LmNsZXJrLmFjY291bnRzLmRldiQ
