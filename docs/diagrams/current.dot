digraph current {
  rankdir=TB;
  compound=true;
  bgcolor="white";
  nodesep=0.28; ranksep=0.62;
  fontname="Arial";
  node [shape=box, style="filled", fillcolor="#eef1f6", color="#5a6472",
        penwidth=1.3, fontname="Arial", fontsize=11,
        height=0.52, width=1.75, margin="0.14,0.08"];
  edge [color="#6b7585", penwidth=1.3, arrowsize=0.75];
  graph [fontname="Arial", fontsize=10];

  subgraph cluster_ui {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>PRESENTATION  &#183;  React</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    u1 [label="Data grid"]; u2 [label="Graph view"]; u3 [label="Problems"];
    u4 [label="History"]; u5 [label="Assistant"];
    {rank=same; u1; u2; u3; u4; u5;}
    u1 -> u2 -> u3 -> u4 -> u5 [style=invis];
  }

  subgraph cluster_api {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>API  &#183;  FastAPI, single process</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    a1 [label="Read endpoints", width=2.6];
    a2 [label="Agent endpoint", width=2.6];
    {rank=same; a1; a2;}
    a1 -> a2 [style=invis];
  }

  subgraph cluster_dom {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>DOMAIN  &#183;  read on the left, write on the right</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    d1 [label="Issue\ndetection"]; d2 [label="Graph engine\n+ cache"];
    d3 [label="Tabular\nquery"]; d4 [label="Version\ncompare"];
    d5 [label="Editor\n4 fixed operations", fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2.0];
    {rank=same; d1; d2; d3; d4; d5;}
    d1 -> d2 -> d3 -> d4 -> d5 [style=invis];
  }

  subgraph cluster_data {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>DATA</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    st [label=<<B>In-memory version store</B><BR/><FONT POINT-SIZE="9.5">v0 original, never modified &#183; v1, v2 &#8230; one per edit &#183; audit log</FONT>>,
        shape=box3d, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2.0, width=5.4, height=0.72];
  }

  llm [label=<<B>Language model</B><BR/><FONT POINT-SIZE="9.5">via OpenRouter</FONT>>,
       shape=box, style="filled,dashed", fillcolor="#dbe7f6", color="#3a6fa8",
       penwidth=1.6, width=1.9, height=0.62];

  u3 -> a1 [ltail=cluster_ui, lhead=cluster_api];
  a1 -> d1 [lhead=cluster_dom, label=<<FONT POINT-SIZE="9" COLOR="#445061">direct reads</FONT>>];
  a2 -> d5 [label=<<FONT POINT-SIZE="9" COLOR="#6b3fb0">on explicit instruction</FONT>>];
  d3 -> st [ltail=cluster_dom, lhead=cluster_data];
  a2 -> llm [dir=both, constraint=false,
             label=<<FONT POINT-SIZE="9" COLOR="#3a6fa8">chooses a tool</FONT>>];
}
