digraph system {
  rankdir=TB; compound=true; bgcolor="white";
  nodesep=0.32; ranksep=0.55;
  node [shape=box, style="filled", fillcolor="#eef1f6", color="#5a6472", penwidth=1.3,
        fontname="Arial", fontsize=11, height=0.55, width=1.9, margin="0.14,0.08"];
  edge [color="#6b7585", penwidth=1.3, arrowsize=0.75, fontname="Arial", fontsize=9, fontcolor="#445061"];

  subgraph cluster_client {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>CLIENT  ·  React 18 + Vite</B></FONT>>; labeljust=l;
    style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; margin=12;
    web [label=<<B>Web application</B><BR/><FONT POINT-SIZE="9">landing page · spreadsheet grid · assistant<BR/>history · schema · Excel formulas</FONT>>, width=3.6];
  }

  clerk [label=<<B>Clerk</B><BR/><FONT POINT-SIZE="9">sign-in · session tokens (JWT)</FONT>>,
         fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2];

  subgraph cluster_api {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>API  ·  FastAPI (Python 3.13)</B></FONT>>; labeljust=l;
    style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; margin=12;
    authm [label=<<B>Token verification</B><BR/><FONT POINT-SIZE="9">JWKS · issuer · expiry · origin</FONT>>, fillcolor="#e6dbf7", color="#6b3fb0"];
    data  [label=<<B>Data service</B><BR/><FONT POINT-SIZE="9">upload · grid · diff · export</FONT>>];
    schema[label=<<B>Schema profiler</B><BR/><FONT POINT-SIZE="9">column roles for any file</FONT>>];
    diag  [label=<<B>Diagnostics</B><BR/><FONT POINT-SIZE="9">read-only issue checks</FONT>>];
    agent [label=<<B>Assistant</B><BR/><FONT POINT-SIZE="9">tool selection · grounded answers</FONT>>, fillcolor="#dbe7f6", color="#3a6fa8", penwidth=2];
    edit  [label=<<B>Edit service</B><BR/><FONT POINT-SIZE="9">four fixed operations</FONT>>, fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2];
    {rank=same; authm; data; schema;}
    {rank=same; diag; agent; edit;}
    authm -> data -> schema [style=invis];
    diag -> agent -> edit [style=invis];
  }

  worker [label=<<B>Graph sync worker</B><BR/><FONT POINT-SIZE="9">applies each change to the graph</FONT>>];
  llm [label=<<B>LLM (OpenRouter)</B><BR/><FONT POINT-SIZE="9">chooses tools · writes answers</FONT>>,
       style="filled,dashed", fillcolor="#fff6e5", color="#b7791f", penwidth=1.6];

  subgraph cluster_data {
    label=<<FONT POINT-SIZE="9" COLOR="#2a6f4e"><B>DATA</B></FONT>>; labeljust=l;
    style="filled,rounded"; fillcolor="#f7fbf9"; color="#9ecfb5"; margin=12;
    pg  [label=<<B>PostgreSQL</B><BR/><FONT POINT-SIZE="9">users · sessions · versions<BR/>audit log · chat</FONT>>, shape=cylinder, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2, height=0.95];
    snap[label=<<B>Snapshot storage</B><BR/><FONT POINT-SIZE="9">one file per version<BR/>disk or S3</FONT>>, shape=cylinder, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2, height=0.95];
    neo [label=<<B>Neo4j</B><BR/><FONT POINT-SIZE="9">knowledge graph<BR/>full-text name index</FONT>>, shape=cylinder, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2, height=0.95];
    rd  [label=<<B>Redis</B><BR/><FONT POINT-SIZE="9">graph sync queue</FONT>>, shape=cylinder, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2, height=0.95];
    {rank=same; pg; snap; neo; rd;}
    pg -> snap -> neo -> rd [style=invis];
  }

  web -> clerk [label="sign in", constraint=false];
  web -> authm [lhead=cluster_api, label="HTTPS + Bearer token"];
  data -> pg [label="metadata"];
  data -> snap [label="snapshots"];
  agent -> neo [label="graph queries"];
  agent -> llm [label="prompt + retrieved facts", constraint=false];
  edit -> pg [label="new version + audit"];
  edit -> rd [label="change event"];
  rd -> worker [label="queue"];
  worker -> neo [label="update rows"];
}
