digraph target {
  rankdir=TB;
  compound=true;
  bgcolor="white";
  nodesep=0.28; ranksep=0.58;
  fontname="Arial";
  node [shape=box, style="filled", fillcolor="#eef1f6", color="#5a6472",
        penwidth=1.3, fontname="Arial", fontsize=11,
        height=0.52, width=1.75, margin="0.14,0.08"];
  edge [color="#6b7585", penwidth=1.3, arrowsize=0.75];
  graph [fontname="Arial", fontsize=10];

  subgraph cluster_ui {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>PRESENTATION  &#183;  unchanged, served as static files</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    u1 [label="Data grid"]; u2 [label="Graph view"]; u3 [label="Problems"];
    u4 [label="History"]; u5 [label="Assistant"];
    {rank=same; u1; u2; u3; u4; u5;}
    u1 -> u2 -> u3 -> u4 -> u5 [style=invis];
  }

  subgraph cluster_acc {
    label=<<FONT POINT-SIZE="9" COLOR="#6b3fb0"><B>ACCESS  &#183;  NEW</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#faf7fe"; color="#b58cff"; penwidth=1.2;
    margin=12;
    ac [label=<<B>Authentication and ownership</B><BR/><FONT POINT-SIZE="9.5">identity on every request &#183; owner check on every session<BR/>disabled by an environment flag for the public demo</FONT>>,
        fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2.0, width=5.6, height=0.80];
  }

  subgraph cluster_api {
    label=<<FONT POINT-SIZE="9" COLOR="#7a8697"><B>API  &#183;  stateless, horizontally scalable</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#fbfcfd"; color="#c8d0dc"; penwidth=1.2;
    margin=12;
    w1 [label="worker 1"]; w2 [label="worker 2"]; w3 [label="worker n"];
    {rank=same; w1; w2; w3;}
    w1 -> w2 -> w3 [style=invis];
  }

  subgraph cluster_dom {
    label=<<FONT POINT-SIZE="9" COLOR="#2a6f4e"><B>DOMAIN  &#183;  UNCHANGED &#8212; no code touched here</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#f7fbf9"; color="#9ecfb5"; penwidth=1.2;
    margin=12;
    d1 [label="Issue\ndetection"]; d2 [label="Graph engine"];
    d3 [label="Tabular\nquery"]; d4 [label="Version\ncompare"];
    d5 [label="Editor\n4 fixed operations", fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2.0];
    {rank=same; d1; d2; d3; d4; d5;}
    d1 -> d2 -> d3 -> d4 -> d5 [style=invis];
  }

  subgraph cluster_data {
    label=<<FONT POINT-SIZE="9" COLOR="#6b3fb0"><B>DATA  &#183;  REPLACED &#8212; state leaves the process</B></FONT>>;
    labeljust=l; style="filled,rounded"; fillcolor="#faf7fe"; color="#b58cff"; penwidth=1.2;
    margin=12;
    pg [label=<<B>PostgreSQL</B><BR/><FONT POINT-SIZE="9.5">users &#183; sessions<BR/>version index &#183; audit<BR/>unique (session, version)</FONT>>,
        shape=box3d, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2.0, width=2.3, height=0.86];
    ob [label=<<B>Object storage</B><BR/><FONT POINT-SIZE="9.5">Parquet snapshots<BR/>v0 &#8230; vN<BR/>nulls preserved</FONT>>,
        shape=box3d, fillcolor="#d6ece0", color="#2a6f4e", penwidth=2.0, width=2.3, height=0.86];
    rd [label=<<B>Redis</B><BR/><FONT POINT-SIZE="9.5">shared graph cache<BR/>workers agree</FONT>>,
        shape=box3d, fillcolor="#e6dbf7", color="#6b3fb0", penwidth=2.0, width=2.3, height=0.86];
    {rank=same; pg; ob; rd;}
    pg -> ob -> rd [style=invis];
  }

  llm [label=<<B>Language model</B><BR/><FONT POINT-SIZE="9.5">via OpenRouter</FONT>>,
       shape=box, style="filled,dashed", fillcolor="#dbe7f6", color="#3a6fa8",
       penwidth=1.6, width=1.9, height=0.62];

  u3 -> ac [ltail=cluster_ui, lhead=cluster_acc];
  ac -> w2 [lhead=cluster_api, label=<<FONT POINT-SIZE="9" COLOR="#6b3fb0">identity attached</FONT>>];
  w2 -> d3 [ltail=cluster_api, lhead=cluster_dom];
  d3 -> ob [ltail=cluster_dom, lhead=cluster_data];
  w3 -> llm [dir=both, constraint=false,
             label=<<FONT POINT-SIZE="9" COLOR="#3a6fa8">chooses a tool</FONT>>];
}
